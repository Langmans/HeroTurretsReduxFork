# Normalize line endings for text files
* text=auto eol=lf

# Keep Lua and config files as text with LF
*.lua text eol=lf
*.json text eol=lf
*.cfg text eol=lf
*.txt text eol=lf
*.md text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.ogg binary
*.wav binary

# Exclude development-only files from git archive / mod portal publish package
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
.vscode export-ignore
scripts export-ignore
readme.md export-ignore
.tmp export-ignore
.tmp/** export-ignore
.luarc.json export-ignore
